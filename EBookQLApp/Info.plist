<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>EBookQL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>EBookQL — MIT Licence. MOBI parsing by libmobi (LGPL-3.0-or-later).</string>
	<!-- The MOBI family and FictionBook have no system-declared UTI, so EBookQL
	     declares those. `.epub` is covered by org.idpf.epub-container, which the system
	     provides. .md and .markdown are covered by net.daringfireball.markdown: EBookQL
	     references it directly rather than declaring an own type. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<!-- FictionBook. Measured on macOS 15.8: nothing declares .fb2, so until
		     EBookQL does, `UTType(filenameExtension: "fb2")` is a dynamic type and
		     Quick Look has no way to know an FB2 file is a book. It is XML with
		     base64 images inside, and it conforms to public.xml as well as
		     public.data for that reason. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>FictionBook document</string>
			<key>UTTypeIdentifier</key>
			<string>com.rocaltair.fb2</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fb2</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-fictionbook+xml</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Mobi document</string>
			<key>UTTypeIdentifier</key>
			<string>com.rocaltair.mobi</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mobi</string>
					<string>azw</string>
					<string>azw3</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-mobipocket-ebook</string>
			</dict>
		</dict>
		<!-- MDX has no system-declared UTI either. Conforming to
		     net.daringfireball.markdown (and public.plain-text) means macOS still
		     treats .mdx as Markdown when EBookQL's extension is not chosen. -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>net.daringfireball.markdown</string>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeDescription</key>
			<string>MDX document</string>
			<key>UTTypeIdentifier</key>
			<string>com.rocaltair.mdx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mdx</string>
				</array>
				<key>public.mime-type</key>
				<string>text/markdown</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
